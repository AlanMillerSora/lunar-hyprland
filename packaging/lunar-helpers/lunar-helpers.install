# lunar-helpers.install — хуки pacman для пакета root-хелперов.
#
# Хелперы — обычные файлы в /usr/libexec/lunar/. После установки и
# обновления прошу systemd перечитать юниты: lunar-cpu-performance
# зовёт /usr/libexec/lunar/cpu-performance.sh. Заодно убираю старые
# копии из /usr/local/lib/lunar (до пакета install.sh клал их туда;
# sudoers уже смотрит на новый путь).

_lunar_helpers_reload() {
  systemctl daemon-reload 2>/dev/null || true

  # миграция со старого пути: сношу только свои имена, каталог — если пуст
  local old=/usr/local/lib/lunar f
  if [ -d "$old" ]; then
    for f in avatar-sync.sh journal-read.sh journal-vacuum.sh \
             cpu-performance.sh svc.sh update.sh; do
      [ -e "$old/$f" ] && rm -f "$old/$f" || true
    done
    rmdir "$old" 2>/dev/null || true
  fi
}

post_install() {
  _lunar_helpers_reload
  echo "lunar-helpers: хелперы в /usr/libexec/lunar/, старый /usr/local/lib/lunar убран"
}

post_upgrade() {
  _lunar_helpers_reload
}

pre_remove() {
  systemctl daemon-reload 2>/dev/null || true
}
