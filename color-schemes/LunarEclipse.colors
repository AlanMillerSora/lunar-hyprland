# ═══ Lunar Eclipse · цветовая схема KDE ═══
# Сгенерировано eclipse-palette.py (пресет: lunar). Руками не правь —
# меняй palette.toml и перезапускай генератор.
# Лежит в ~/.local/share/color-schemes/, kdeglobals ссылается по имени.
# Секции и токены считаю от единой палитры: фон/поверхности, текст, акцент,
# danger и ok (зелёного нет — «успех» тоже светлый).

[General]
Name=Lunar Eclipse
ColorScheme=Lunar Eclipse
shadeSortColumn=true

[Colors:Window]
BackgroundNormal=8,9,13
BackgroundAlternate=12,14,19
ForegroundNormal=232,236,242
ForegroundInactive=152,161,172
ForegroundActive=232,237,244
ForegroundLink=232,237,244
ForegroundVisited=152,161,172
ForegroundNegative=255,0,60
ForegroundNeutral=152,161,172
ForegroundPositive=232,237,244
DecorationFocus=232,237,244
DecorationHover=232,237,244

