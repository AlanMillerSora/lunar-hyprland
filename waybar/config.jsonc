{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 7,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "modules-left": [
        "custom/logo",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "battery",
        "tray"
    ],
    "custom/logo": {
        "format": "󰖔",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "󰽨",
            "I": "󰽨",
            "2": "󰽡",
            "II": "󰽡",
            "3": "󰽥",
            "III": "󰽥",
            "4": "󰽤",
            "IV": "󰽤",
            "5": "󰽧",
            "V": "󰽧",
            "6": "󰽣",
            "VI": "󰽣",
            "7": "󰽦",
            "VII": "󰽦",
            "8": "󰽢",
            "VIII": "󰽢"
        },
        "on-click": "activate",
        "on-scroll-up": "hyprctl eval 'hl.dispatch(hl.dsp.focus({workspace = \"e+1\"}))'",
        "on-scroll-down": "hyprctl eval 'hl.dispatch(hl.dsp.focus({workspace = \"e-1\"}))'",
        "sort-by": "id",
        "active-only": false,
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4,
                5,
                6,
                7,
                8
            ]
        },
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}\nнажми — календарь",
        "on-click": "~/.config/hypr/scripts/eclipse-calendar.py",
        "interval": 10
    },
    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "on-click": "kitty -e btop"
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰕾"
        ],
        "tooltip-format": "{desc}",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰖪",
        "format-linked": "󰖪 {essid}",
        "tooltip-format-wifi": "{essid}\n{signalStrength}%\nнажми — выбрать сеть",
        "tooltip-format-disconnected": "Wi-Fi отключён\nнажми — включить",
        "interval": 10,
        "on-click": "~/.config/hypr/scripts/eclipse-network.sh menu",
        "on-click-right": "nm-connection-editor"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": {
            "charging": "󰂄",
            "warning": "󰂃",
            "critical": "󰂃",
            "default": "󰁹"
        },
        "tooltip-format": "{timeTo} {power}"
    },
    "tray": {
        "spacing": 8,
        "icon-size": 15
    }
}
