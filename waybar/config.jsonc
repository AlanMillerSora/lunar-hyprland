{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 10,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["custom/eclipse-pbar", "clock"],
    "modules-right": ["tray", "pulseaudio", "network", "cpu", "memory", "battery", "custom/date"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "sort-by-number": true,
        "active-only": false,
        "separate-outputs": true
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    "custom/eclipse-pbar": {
        "exec": "~/.config/hypr/scripts/eclipse-pbar.sh",
        "return-type": "json",
        "interval": 1,
        "tooltip": true
    },

    "clock": {
        "format": "{:%H:%M:%S}",
        "tooltip-format": "{:%A, %d %B %Y}",
        "interval": 1
    },

    "custom/date": {
        "exec": "date '+%a %d %b'",
        "interval": 60,
        "format": "{}"
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "MUTED",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "network": {
        "format-wifi": "{signalStrength}%",
        "format-ethernet": "ETH",
        "format-disconnected": "off",
        "interval": 10
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "RAM {}%",
        "interval": 5
    },

    "battery": {
        "format-charging": "{capacity}%+",
        "format-plugged": "{capacity}%",
        "format": "{capacity}%",
        "tooltip-format": "{timeTo} {power}"
    },

    "tray": {
        "spacing": 10
    }
}