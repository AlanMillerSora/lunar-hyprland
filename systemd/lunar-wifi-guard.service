[Unit]
Description=Lunar Wi-Fi guard — страховка от «умирания» Wi-Fi
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/hypr/scripts/eclipse-wifi-guard.py
# Профиль Wi-Fi — из пользовательского файла: SSID не хардкодим в публичном репо.
# Формат файла: LUNAR_WIFI_PROFILE=<имя профиля NetworkManager>
# Файла нет — скрипт сам возьмёт первый сохранённый профиль.
EnvironmentFile=-%h/.config/lunar/wifi-profile
Restart=always
RestartSec=5

[Install]
WantedBy=default.target