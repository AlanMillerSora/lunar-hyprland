[Unit]
Description=Lunar Eclipse — локальная страница для новой вкладки Firefox
After=network.target

[Service]
Type=simple
# отдаём только ~/.config/lunar, только на localhost — расширению Firefox
# нельзя открывать file://, поэтому новая вкладка берёт страницу отсюда
ExecStart=/usr/bin/python3 -m http.server 8787 --bind 127.0.0.1 --directory %h/.config/lunar
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
