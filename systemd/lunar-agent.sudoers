# ════════════════════════════════════════════════════════════════
#  Lunar Eclipse — sudo-права для агента в чате (OpenCode).
#
#  Узкий белый список: без пароля запускается только перечисленное,
#  всё остальное — с подтверждением в чате OpenCode.
#
#  Принципы:
#    • только целевой пользователь (имя подставляет install.sh; раньше было %wheel);
#    • журнал читает root-хелпер journal-read.sh (в самом journalctl
#      мутирующие режимы --vacuum/--rotate недоступны);
#    • systemctl — только конкретные юниты, без путей и без масок;
#    • pacman — только -Syu и -Syu --noconfirm;
#    • из пользовательских каталогов — только root-хелперы /usr/local/lib/lunar/.
#
#  Ставится из install.sh в /etc/sudoers.d/lunar-agent (0440 root:root).
#  Проверка: sudo -n -l
# ════════════════════════════════════════════════════════════════

# чтение журнала — через хелпер (он пропускает только читающие опции)
Cmnd_Alias LUNAR_READ = \
  /usr/local/lib/lunar/journal-read.sh, \
  /usr/local/lib/lunar/journal-read.sh *, \
  /usr/bin/systemctl --no-pager status, \
  /usr/bin/systemctl --no-pager status *, \
  /usr/bin/systemctl --no-pager list-units, \
  /usr/bin/systemctl --no-pager list-units *, \
  /usr/bin/dmidecode -t memory

# управление только этими юнитами (точные имена; user-юниты lunar-*
# управляются без sudo — через systemctl --user)
Cmnd_Alias LUNAR_SVC = \
  /usr/bin/systemctl start zapret.service, \
  /usr/bin/systemctl stop zapret.service, \
  /usr/bin/systemctl restart zapret.service, \
  /usr/bin/systemctl reload zapret.service, \
  /usr/bin/systemctl enable zapret.service, \
  /usr/bin/systemctl disable zapret.service, \
  /usr/bin/systemctl enable --now zapret.service, \
  /usr/bin/systemctl disable --now zapret.service, \
  /usr/bin/systemctl start sddm.service, \
  /usr/bin/systemctl stop sddm.service, \
  /usr/bin/systemctl restart sddm.service, \
  /usr/bin/systemctl reload sddm.service, \
  /usr/bin/systemctl enable sddm.service, \
  /usr/bin/systemctl disable sddm.service, \
  /usr/bin/systemctl start bluetooth.service, \
  /usr/bin/systemctl stop bluetooth.service, \
  /usr/bin/systemctl restart bluetooth.service, \
  /usr/bin/systemctl reload bluetooth.service, \
  /usr/bin/systemctl enable bluetooth.service, \
  /usr/bin/systemctl disable bluetooth.service, \
  /usr/bin/systemctl start docker.service, \
  /usr/bin/systemctl stop docker.service, \
  /usr/bin/systemctl restart docker.service, \
  /usr/bin/systemctl reload docker.service, \
  /usr/bin/systemctl enable docker.service, \
  /usr/bin/systemctl disable docker.service, \
  /usr/bin/systemctl start libvirtd.service, \
  /usr/bin/systemctl stop libvirtd.service, \
  /usr/bin/systemctl restart libvirtd.service, \
  /usr/bin/systemctl reload libvirtd.service, \
  /usr/bin/systemctl enable libvirtd.service, \
  /usr/bin/systemctl disable libvirtd.service

# пакеты: только обновление системы (без произвольных аргументов)
Cmnd_Alias LUNAR_PKG = \
  /usr/bin/pacman -Syu, \
  /usr/bin/pacman -Syu --noconfirm

# root-хелперы риса (root:root, пользователь их не редактирует)
Cmnd_Alias LUNAR_HELP = \
  /usr/local/lib/lunar/avatar-sync.sh, \
  /usr/local/lib/lunar/journal-vacuum.sh, \
  /usr/local/lib/lunar/journal-vacuum.sh *

sora ALL=(root) NOPASSWD: LUNAR_READ, LUNAR_SVC, LUNAR_PKG, LUNAR_HELP
