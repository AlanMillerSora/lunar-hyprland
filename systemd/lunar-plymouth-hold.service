[Unit]
Description=Lunar Eclipse — держим заставку до экрана входа
DefaultDependencies=no
After=plymouth-start.service sddm.service
Before=plymouth-quit-wait.service
ConditionKernelCommandLine=!plymouth.enable=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/lunar/plymouth-hold.sh
TimeoutSec=15

[Install]
WantedBy=multi-user.target
