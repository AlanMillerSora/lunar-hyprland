[Unit]
Description=Lunar Eclipse — CPU performance после сна
ConditionPathExists=/usr/libexec/lunar/cpu-performance.sh
After=hibernate.target hybrid-sleep.target
Before=suspend.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/lunar/cpu-performance.sh

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target
