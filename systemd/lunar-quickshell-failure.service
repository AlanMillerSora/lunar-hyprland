[Unit]
Description=Lunar Eclipse — диагностика падения Quickshell
# Запускается через OnFailure у lunar-quickshell.service: пишет лог и
# (не чаще раза в минуту) уведомляет с подсказкой. Это НЕ Restart=always.

[Service]
Type=oneshot
ExecStart=/usr/bin/sh -c 'mkdir -p %h/.cache/lunar; log=%h/.cache/lunar/quickshell-failure.log; echo "$(date "+%%F %%T") падение lunar-quickshell (failed)" >> "$log"; now=$(date +%%s); last=$(cat %h/.cache/lunar/quickshell-failure.stamp 2>/dev/null || echo 0); case "$last" in ""|*[!0-9]*) last=0;; esac; if [ $((now - last)) -ge 60 ]; then echo "$now" > %h/.cache/lunar/quickshell-failure.stamp; if command -v notify-send >/dev/null; then notify-send -a Quickshell "Quickshell не поднялся" "Проверь: systemctl --user status lunar-quickshell.service. Сброс: systemctl --user reset-failed lunar-quickshell.service" || true; fi; fi'
