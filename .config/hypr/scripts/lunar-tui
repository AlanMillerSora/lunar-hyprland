#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════════
#  lunar-tui — показать/убрать в фон окно-плеер Lunar (Qt, PySide6).
#  SUPER+M: приложение уже живо → шлю USR1 (свернуть/развернуть окно);
#  иначе — запускаю. В фоне музыка продолжает играть (окно лишь скрыто).
# ════════════════════════════════════════════════════════════════════════
set -u
APP="$HOME/.config/lunar/tui/lunar_qt.py"
PIDF="/tmp/lunar-tui.pid"

[ -f "$APP" ] || { echo "lunar-tui: нет $APP" >&2; exit 1; }

if [ -f "$PIDF" ]; then
  pid="$(cat "$PIDF" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill -USR1 "$pid" 2>/dev/null       # свернуть/развернуть
    exit 0
  fi
fi

exec python3 "$APP" "$@"
