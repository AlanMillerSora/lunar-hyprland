{
  // ════════════════════════════════════════════════════════════════
  //  Lunar Eclipse — VS Code в терминальном стиле (монохром, как btop).
  //  Палитра системы: фон #050505, текст #ffffff, dim #888888,
  //  опасность #ff003c, рамки #1e1e1e, монопространственный шрифт.
  //  Файл кладётся в ~/.config/Code/User/settings.json (install.sh).
  // ════════════════════════════════════════════════════════════════

  // ── тема ───────────────────────────────────────────────────────
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.preferredDarkColorTheme": "Default Dark Modern",
  "workbench.iconTheme": null,                 // без иконок файлов — TUI
  "workbench.productIconTheme": "Default",
  "editor.semanticHighlighting.enabled": false, // цвет только из токенов ниже
  "editor.bracketPairColorization.enabled": false,
  "editor.guides.bracketPairs": false,
  "editor.guides.indentation": false,
  "editor.guides.highlightActiveIndentation": false,

  "editor.tokenColorCustomizations": {
    "textMateRules": [
      { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#4a4a4a", "fontStyle": "italic" } },
      { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#ffffff", "fontStyle": "bold" } },
      { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#cccccc" } },
      { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#ffffff" } },
      { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#ffffff" } },
      { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.name.tag"], "settings": { "foreground": "#ffffff", "fontStyle": "underline" } },
      { "scope": ["variable", "variable.parameter", "variable.other", "meta.object-literal.key"], "settings": { "foreground": "#dddddd" } },
      { "scope": ["variable.language", "variable.language.this"], "settings": { "foreground": "#ffffff", "fontStyle": "italic" } },
      { "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#888888" } },
      { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ff003c" } },
      { "scope": ["markup.heading", "markup.bold"], "settings": { "foreground": "#ffffff", "fontStyle": "bold" } },
      { "scope": ["markup.italic"], "settings": { "foreground": "#dddddd", "fontStyle": "italic" } },
      { "scope": ["markup.inserted", "diff.inserted"], "settings": { "foreground": "#ffffff" } },
      { "scope": ["markup.deleted", "diff.deleted"], "settings": { "foreground": "#888888" } }
    ]
  },

  "workbench.colorCustomizations": {
    "foreground": "#ffffff",
    "focusBorder": "#ffffff",
    "widget.border": "#1e1e1e",
    "widget.shadow": "#00000000",
    "contrastBorder": "#1e1e1e",
    "errorForeground": "#ff003c",
    "descriptionForeground": "#888888",
    "selection.background": "#ffffff33",

    "editor.background": "#050505",
    "editor.foreground": "#ffffff",
    "editorLineNumber.foreground": "#4a4a4a",
    "editorLineNumber.activeForeground": "#ffffff",
    "editorCursor.foreground": "#ffffff",
    "editor.selectionBackground": "#ffffff33",
    "editor.inactiveSelectionBackground": "#ffffff1a",
    "editor.selectionHighlightBackground": "#ffffff1a",
    "editor.wordHighlightBackground": "#ffffff1a",
    "editor.lineHighlightBackground": "#0d0d0d",
    "editor.lineHighlightBorder": "#00000000",
    "editorWhitespace.foreground": "#1e1e1e",
    "editorIndentGuide.background1": "#1e1e1e",
    "editorIndentGuide.activeBackground1": "#2a2a2a",
    "editorGutter.background": "#050505",
    "editorGutter.modifiedBackground": "#ffffff",
    "editorGutter.addedBackground": "#888888",
    "editorGutter.deletedBackground": "#ff003c",
    "editorOverviewRuler.border": "#00000000",
    "editorRuler.foreground": "#1e1e1e",
    "editorWidget.background": "#050505",
    "editorWidget.foreground": "#ffffff",
    "editorWidget.border": "#1e1e1e",
    "editorHoverWidget.background": "#050505",
    "editorHoverWidget.border": "#1e1e1e",
    "editorSuggestWidget.background": "#050505",
    "editorSuggestWidget.border": "#1e1e1e",
    "editorSuggestWidget.foreground": "#ffffff",
    "editorSuggestWidget.selectedBackground": "#ffffff1a",
    "editorSuggestWidget.highlightForeground": "#ffffff",

    "sideBar.background": "#050505",
    "sideBar.foreground": "#888888",
    "sideBar.border": "#1e1e1e",
    "sideBarSectionHeader.background": "#050505",
    "sideBarSectionHeader.foreground": "#ffffff",
    "sideBarSectionHeader.border": "#1e1e1e",
    "sideBarTitle.foreground": "#ffffff",

    "activityBar.background": "#050505",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#4a4a4a",
    "activityBar.border": "#1e1e1e",
    "activityBar.activeBorder": "#ffffff",
    "activityBarBadge.background": "#ffffff",
    "activityBarBadge.foreground": "#000000",

    "statusBar.background": "#050505",
    "statusBar.foreground": "#888888",
    "statusBar.border": "#1e1e1e",
    "statusBar.noFolderBackground": "#050505",
    "statusBar.debuggingBackground": "#050505",
    "statusBarItem.hoverBackground": "#ffffff1a",
    "statusBarItem.remoteForeground": "#ffffff",

    "titleBar.activeBackground": "#050505",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#050505",
    "titleBar.inactiveForeground": "#4a4a4a",
    "titleBar.border": "#1e1e1e",

    "menu.background": "#050505",
    "menu.foreground": "#ffffff",
    "menu.border": "#1e1e1e",
    "menu.selectionBackground": "#ffffff1a",
    "menu.selectionForeground": "#ffffff",
    "menubar.selectionBackground": "#ffffff1a",
    "menubar.selectionForeground": "#ffffff",

    "input.background": "#0d0d0d",
    "input.foreground": "#ffffff",
    "input.border": "#1e1e1e",
    "inputOption.activeBackground": "#ffffff1a",
    "inputOption.activeBorder": "#ffffff",
    "dropdown.background": "#050505",
    "dropdown.foreground": "#ffffff",
    "dropdown.border": "#1e1e1e",

    "panel.background": "#050505",
    "panel.foreground": "#ffffff",
    "panel.border": "#1e1e1e",
    "panelTitle.activeForeground": "#ffffff",
    "panelTitle.inactiveForeground": "#4a4a4a",
    "panelTitle.activeBorder": "#ffffff",

    "terminal.background": "#050505",
    "terminal.foreground": "#ffffff",
    "terminalCursor.foreground": "#ffffff",
    "terminal.ansiBlack": "#050505",
    "terminal.ansiWhite": "#ffffff",
    "terminal.ansiBrightBlack": "#4a4a4a",
    "terminal.ansiBrightWhite": "#ffffff",
    "terminal.selectionBackground": "#ffffff33",

    "tab.activeBackground": "#050505",
    "tab.activeForeground": "#ffffff",
    "tab.activeBorder": "#ffffff",
    "tab.activeBorderTop": "#00000000",
    "tab.inactiveBackground": "#050505",
    "tab.inactiveForeground": "#4a4a4a",
    "tab.border": "#1e1e1e",
    "tab.unfocusedActiveBorder": "#2a2a2a",
    "editorGroupHeader.tabsBackground": "#050505",
    "editorGroupHeader.tabsBorder": "#1e1e1e",
    "editorGroupHeader.border": "#1e1e1e",
    "editorGroup.border": "#1e1e1e",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#ffffff1a",
    "scrollbarSlider.hoverBackground": "#ffffff2a",
    "scrollbarSlider.activeBackground": "#ffffff33",

    "list.activeSelectionBackground": "#ffffff1a",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#ffffff0d",
    "list.hoverBackground": "#ffffff0d",
    "list.focusOutline": "#ffffff",
    "list.highlightForeground": "#ffffff",

    "badge.background": "#ffffff",
    "badge.foreground": "#000000",
    "button.background": "#ffffff",
    "button.foreground": "#000000",
    "button.hoverBackground": "#cccccc",
    "button.secondaryBackground": "#0d0d0d",
    "button.secondaryForeground": "#ffffff",
    "checkbox.background": "#0d0d0d",
    "checkbox.border": "#1e1e1e",
    "checkbox.foreground": "#ffffff",

    "quickInput.background": "#050505",
    "quickInput.foreground": "#ffffff",
    "quickInputList.focusBackground": "#ffffff1a",
    "quickInputList.focusForeground": "#ffffff",
    "pickerGroup.border": "#1e1e1e",
    "pickerGroup.foreground": "#888888",

    "gitDecoration.addedResourceForeground": "#ffffff",
    "gitDecoration.modifiedResourceForeground": "#ffffff",
    "gitDecoration.untrackedResourceForeground": "#888888",
    "gitDecoration.deletedResourceForeground": "#ff003c",
    "gitDecoration.conflictingResourceForeground": "#ff003c",
    "gitDecoration.ignoredResourceForeground": "#4a4a4a",

    "problemsErrorIcon.foreground": "#ff003c",
    "problemsWarningIcon.foreground": "#888888",
    "problemsInfoIcon.foreground": "#888888",
    "editorError.foreground": "#ff003c",
    "editorWarning.foreground": "#888888",
    "editorInfo.foreground": "#888888",

    "notifications.background": "#050505",
    "notifications.border": "#1e1e1e",
    "notifications.foreground": "#ffffff",
    "notificationCenterHeader.background": "#0d0d0d",
    "notificationLink.foreground": "#ffffff"
  },

  // ── вид «терминала»: без лишнего ──────────────────────────────
  "editor.minimap.enabled": false,
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerLanes": 0,
  "editor.stickyScroll.enabled": false,
  "editor.renderLineHighlight": "none",
  "editor.renderWhitespace": "none",
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.matchBrackets": "never",
  "editor.roundedSelection": false,
  "editor.scrollBeyondLastLine": false,
  "editor.smoothScrolling": false,
  "workbench.list.smoothScrolling": false,
  "breadcrumbs.enabled": false,
  "workbench.layoutControl.enabled": false,
  "workbench.commandCenter": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.editor.empty.hint": "hidden",
  "window.menuBarVisibility": "hidden",
  "window.commandCenter": false,
  "explorer.compactFolders": false,
  "scm.diffDecorations": "none",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "chat.disableAIFeatures": true,
  "workbench.welcomePage.walkthroughs.openOnInstall": false,

  // ── шрифт и курсор (как в терминале) ──────────────────────────
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 13,
  "editor.lineHeight": 1.5,
  "editor.cursorStyle": "block",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.15,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.smoothScrolling": false,
  "debug.console.fontFamily": "'JetBrainsMono Nerd Font', monospace",

  // ── поведение ─────────────────────────────────────────────────
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "workbench.editor.enablePreview": true,
  "telemetry.telemetryLevel": "off",
  "update.mode": "none",
  "workbench.enableExperiments": false,
  "extensions.autoUpdate": false,
  "security.workspace.trust.enabled": false
}
