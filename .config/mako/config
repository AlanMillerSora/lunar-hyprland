# ════════════════════════════════════════════════════════════
#  mako — уведомления в HUD-стиль системы
# ════════════════════════════════════════════════════════════

font=JetBrains Mono 11

### Стиль по умолчанию
background-color=#0c0e13E6
text-color=#e8ecf2FF
border-color=#23262dFF
border-size=1
border-radius=3
padding=12
margin=20
width=360
height=100

anchor=bottom-right
default-timeout=5000
history=1
icons=1
max-visible=5
# не даём истории уведомлений (её показывает правый сайдбар) расти бесконечно
max-history=20

progress-color=over #e8edf4FF

[urgency=low]
background-color=#0c0e1399
border-color=#98a1acFF
default-timeout=3000

[urgency=critical]
border-color=#FF003CFF
default-timeout=0