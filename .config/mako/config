# ════════════════════════════════════════════════════════════
#  mako — уведомления в HUD-стиль системы
# ════════════════════════════════════════════════════════════

font=JetBrains Mono 11

### Стиль по умолчанию
background-color=#0c0e13E6
text-color=#e8ecf2FF
border-color=#23262dFF
border-size=1
border-radius=3
padding=12
margin=20
width=360
height=100

anchor=bottom-right
default-timeout=5000
history=1
icons=1
max-visible=5
# не даём истории уведомлений (её показывает правый сайдбар) расти бесконечно
max-history=20

progress-color=over #e8edf4FF

# цвета — из единой палитры (eclipse-palette.py).
# include обязан идти до первой секции — после [urgency=…] mako конфиг не парсит.
include=~/.config/mako/colors.conf

# Цвета urgency-секций приходят из include выше (colors.conf, генератор).
# Здесь оставляю только поведение: иначе хардкод перебивал бы палитру.
[urgency=low]
default-timeout=3000

[urgency=critical]
default-timeout=0
