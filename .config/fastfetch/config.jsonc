{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // монохром: «цвета» ASCII-логотипа — оттенки серого
    "logo": {
        "color": {
            "1": "white",
            "2": "#888888",
            "3": "#cccccc",
            "4": "#dddddd",
            "5": "white",
            "6": "white",
            "7": "white",
            "8": "white",
            "9": "white"
        }
    },

    "display": {
        "separator": "  ",
        // ключи — белые, значения — светло-серые, разделитель — faint
        "color": {
            "keys": "white",
            "title": "white",
            "output": "#dddddd",
            "separator": "#4a4a4a"
        },
        "key": {
            "type": "string",
            "color": "white"
        },
        "percent": {
            "type": [
                "num"
            ]
        },
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "width": 12,
            "border": null
        }
    },
    "modules": [
        "break",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        { "type": "wm", "key": "WM" },
        "terminal",
        "cpu",
        "gpu",
        "memory",
        { "type": "disk", "folders": "/" },
        { "type": "localip", "key": "IP" },
        { "type": "battery", "key": "Battery" },
        "break",
        "colors"
    ]
}
