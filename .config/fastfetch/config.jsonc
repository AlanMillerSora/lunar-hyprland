{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // холодный монохром: «цвета» ASCII-логотипа — оттенки серого
    "logo": {
        "color": {
            "1": "#dfe7f2",
            "2": "#93a1b5",
            "3": "#cfd9e8",
            "4": "#7aa2f7",
            "5": "#dfe7f2",
            "6": "#dfe7f2",
            "7": "#dfe7f2",
            "8": "#dfe7f2",
            "9": "#dfe7f2"
        }
    },

    "display": {
        "separator": "  ",
        // ключи — светлые, значения — приглушённые, разделитель — faint
        "color": {
            "keys": "#dfe7f2",
            "title": "#7aa2f7",
            "output": "#cfd9e8",
            "separator": "#556377"
        },
        "key": {
            "type": "string",
            "color": "#7aa2f7"
        },
        "percent": {
            "type": [
                "num"
            ]
        },
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "width": 12,
            "border": null
        }
    },
    "modules": [
        "break",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        { "type": "wm", "key": "WM" },
        "terminal",
        "cpu",
        "gpu",
        "memory",
        { "type": "disk", "folders": "/" },
        { "type": "localip", "key": "IP" },
        { "type": "battery", "key": "Battery" },
        "break",
        "colors"
    ]
}