{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "  ",
        "key": {
            "type": "string",
            "color": "white"
        },
        "percent": {
            "type": [
                "num"
            ]
        },
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "width": 12,
            "border": null
        }
    },
    "modules": [
        "break",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "battery",
        "break",
        "colors"
    ]
}
