# ═══ Lunar Eclipse · btop theme (единая палитра: steel) ═══
# Сгенерировано eclipse-palette.py. Руками не правь.
# Подключение: в btop.conf уже стоит color_theme = "lunar" — этот файл
# и есть тема (btop берёт её из ~/.config/btop/themes/).

theme[main_bg]="#070a10"
theme[main_fg]="#dfe7f2"
theme[title]="#7aa2f7"
theme[hi_fg]="#7aa2f7"
theme[selected_bg]="#17202e"
theme[selected_fg]="#dfe7f2"
theme[inactive_fg]="#556377"
theme[graph_text]="#93a1b5"
theme[meter_bg]="#17202e"
theme[proc_misc]="#7aa2f7"

theme[cpu_box]="#93a1b5"
theme[mem_box]="#93a1b5"
theme[net_box]="#93a1b5"
theme[proc_box]="#93a1b5"
theme[div_line]="#242a34"

theme[temp_start]="#93a1b5"
theme[temp_mid]="#cfd9e8"
theme[temp_end]="#ff4d6a"

theme[cpu_start]="#93a1b5"
theme[cpu_mid]="#cfd9e8"
theme[cpu_end]="#7aa2f7"

theme[free_start]="#556377"
theme[free_mid]="#93a1b5"
theme[free_end]="#cfd9e8"

theme[cached_start]="#93a1b5"
theme[cached_mid]="#cfd9e8"
theme[cached_end]="#7aa2f7"

theme[available_start]="#93a1b5"
theme[available_mid]="#cfd9e8"
theme[available_end]="#7aa2f7"

theme[used_start]="#93a1b5"
theme[used_mid]="#cfd9e8"
theme[used_end]="#7aa2f7"

theme[download_start]="#93a1b5"
theme[download_mid]="#cfd9e8"
theme[download_end]="#7aa2f7"

theme[upload_start]="#93a1b5"
theme[upload_mid]="#cfd9e8"
theme[upload_end]="#7aa2f7"

theme[process_start]="#93a1b5"
theme[process_mid]="#cfd9e8"
theme[process_end]="#7aa2f7"
