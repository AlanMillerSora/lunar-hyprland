# ═══ Lunar Eclipse · btop theme (единая палитра: lunar) ═══
# Сгенерировано eclipse-palette.py. Руками не правь.
# Подключение: в btop.conf уже стоит color_theme = "lunar" — этот файл
# и есть тема (btop берёт её из ~/.config/btop/themes/).

theme[main_bg]="#08090d"
theme[main_fg]="#e8ecf2"
theme[title]="#e8edf4"
theme[hi_fg]="#e8edf4"
theme[selected_bg]="#181b21"
theme[selected_fg]="#e8ecf2"
theme[inactive_fg]="#5b636d"
theme[graph_text]="#98a1ac"
theme[meter_bg]="#181b21"
theme[proc_misc]="#e8edf4"

theme[cpu_box]="#98a1ac"
theme[mem_box]="#98a1ac"
theme[net_box]="#98a1ac"
theme[proc_box]="#98a1ac"
theme[div_line]="#25272d"

theme[temp_start]="#98a1ac"
theme[temp_mid]="#d5dce4"
theme[temp_end]="#ff003c"

theme[cpu_start]="#98a1ac"
theme[cpu_mid]="#d5dce4"
theme[cpu_end]="#e8edf4"

theme[free_start]="#5b636d"
theme[free_mid]="#98a1ac"
theme[free_end]="#d5dce4"

theme[cached_start]="#98a1ac"
theme[cached_mid]="#d5dce4"
theme[cached_end]="#e8edf4"

theme[available_start]="#98a1ac"
theme[available_mid]="#d5dce4"
theme[available_end]="#e8edf4"

theme[used_start]="#98a1ac"
theme[used_mid]="#d5dce4"
theme[used_end]="#e8edf4"

theme[download_start]="#98a1ac"
theme[download_mid]="#d5dce4"
theme[download_end]="#e8edf4"

theme[upload_start]="#98a1ac"
theme[upload_mid]="#d5dce4"
theme[upload_end]="#e8edf4"

theme[process_start]="#98a1ac"
theme[process_mid]="#d5dce4"
theme[process_end]="#e8edf4"
