# ════════════════════════════════════════════════════════════
#  mako — уведомления в тему Lunar Eclipse
# ════════════════════════════════════════════════════════════

font=JetBrains Mono 11

### Стиль по умолчанию
background-color=#0A0A0AB7
text-color=#E6E6E6FF
border-color=#FFFFFF1A
border-size=2
border-radius=12
padding=12
margin=20
width=360
height=100

anchor=bottom-right
default-timeout=5000
history=1
icons=1
max-visible=5

# Заголовок уведомления
progress-color=over #7EA6FFFF

[urgency=low]
background-color=#0A0A0A66
border-color=#6F6F6FFF
default-timeout=3000

[urgency=critical]
border-color=#FF5A5AFF
default-timeout=0