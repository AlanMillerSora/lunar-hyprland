{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/eclipse.png",
        "type": "kitty",
        "width": 24,
        "padding": {
            "top": 2,
            "left": 3,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "type": "string",
            "color": "blue"
        },
        "percent": {
            "type": "num",
            "color": "blue"
        }
    },
    "modules": [
        "break",
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "battery",
        "break",
        "colors"
    ]
}
