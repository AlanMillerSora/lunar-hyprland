{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/eclipse.png",
        "type": "kitty",
        "width": 22,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "type": "string",
            "color": "blue"
        },
        "percent": {
            "type": [
                "num"
            ]
        },
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "width": 12,
            "border": null
        }
    },
    "modules": [
        "break",
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "battery",
        "break",
        "colors"
    ]
}
